# Copy this file to .env (same folder as app/) and edit. Restart the server after changing it.

SPORT=mlb                    # mlb | nba | nfl  (you can also switch on the page)
DRAFT_PLATFORM=manual        # manual | yahoo | espn | mock
                             #   manual = you click Draft for each pick on the page
                             #   yahoo / espn = picks are read automatically from your league
                             #   mock = a simulated live draft, to try the app
POLL_SECONDS=3               # how often to check Yahoo/ESPN (never faster than every 2 seconds)
MY_TEAM_ID=1

# ---- Yahoo (README: "Yahoo setup") ----
YAHOO_LEAGUE_KEY=            # e.g. 458.l.123456. The first number changes every season.
# Also save data/oauth2.json -> {"consumer_key": "...", "consumer_secret": "..."}

# ---- ESPN (README: "ESPN setup") ----
ESPN_LEAGUE_ID=              # the number after leagueId= in your league's ESPN web address
ESPN_YEAR=2027               # the season year
ESPN_S2=                     # private leagues only: cookie copied from your browser
ESPN_SWID=                   # private leagues only: cookie copied from your browser (looks like {XXXXXXXX-XXXX-...})

MOCK_SECONDS_PER_PICK=4      # mock draft speed


# Optional: start with a ready-made league setup. NBA: espn_default (ESPN default points scoring + roster). Blank = standard league.
LEAGUE_PRESET=

# Hosting only. 1 = every browser gets its own private draft kept in memory (never saved to disk, live Yahoo/ESPN sync off).
# Leave blank on your own computer: one draft, saved to disk.
MULTI_SESSION=
MAX_SESSIONS=100
SESSION_HOURS=3
